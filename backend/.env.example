# Copy to .env in this folder (never commit .env).
# Use a DEV Supabase project locally — not production.

SUPABASE_DB_CONNECTION_STRING=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MAX_JD_CHARS=12000
LLM_RATE_LIMIT_PER_MINUTE=10

# Browser origin(s) allowed by CORS (no trailing slash). Comma-separated if needed.
# Local default if unset: http://localhost:3000
# Production (Render): https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000
