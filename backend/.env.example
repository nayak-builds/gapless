# Copy to .env in this folder (never commit .env).
# Use a DEV Supabase project locally — not production.

SUPABASE_DB_CONNECTION_STRING=
# Prefer Database → Connect → Session pooler (port 6543). Direct db.*.supabase.co:5432
# often times out on Windows (IPv6). URI must not be committed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MAX_JD_CHARS=12000
MAX_NOTE_CHARS=100000
LLM_RATE_LIMIT_PER_MINUTE=10
NOTES_RATE_LIMIT_PER_MINUTE=10
# Local ONNX MiniLM cache (gitignored). Render free disk is ephemeral; vectors live in Postgres.
EMBED_CACHE=

# Browser origin(s) allowed by CORS (no trailing slash). Comma-separated if needed.
# Local default if unset: http://localhost:3000
# Production (Render): https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000
