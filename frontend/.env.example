# Copy to .env.local in this folder (never commit .env.local).
# Use a DEV Supabase project — not production.
# Restart `npm run dev` after changing NEXT_PUBLIC_* values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# FastAPI origin, no trailing slash. NEXT_PUBLIC_API_BASE_URL is still accepted.
NEXT_PUBLIC_API_URL=http://localhost:8000
