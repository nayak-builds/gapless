# Gapless environment template
# Copy to .env.local (gitignored). Never put production values here.

# local | preview | production
ENVIRONMENT=local
LOG_LEVEL=info

# Frontend origin(s) allowed by FastAPI CORS (comma-separated; no trailing slash)
FRONTEND_URL=http://localhost:3000

# Public API URL for the Next.js app (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (use a DEV project locally)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
# Backend only — never expose to the browser or commit a real value
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Postgres (often the Supabase URI)
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/gapless

# LLM — set only the provider you use; keep keys backend-only
LLM_PROVIDER=openai
LLM_MODEL=replace-me
LLM_MAX_TOKENS=2048
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings / RAG (Version 2)
EMBEDDING_MODEL=replace-me
CHROMA_PERSIST_DIR=.chroma

# Uploads / abuse controls
MAX_JD_CHARS=20000
MAX_UPLOAD_MB=5
LLM_RATE_LIMIT_PER_MINUTE=10

# Observability (optional locally)
SENTRY_DSN=
